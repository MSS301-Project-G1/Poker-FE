# ${VAR} placeholders are filled from the container environment at startup (see Dockerfile).
# nginx's own $variables are left alone because they are not environment variables.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Vite output in /assets is content-hashed, so it can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # REST goes through the API gateway. Host keeps the browser's host:port so the
    # backend treats the request as same-origin instead of rejecting it as CORS.
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The gateway has no WebSocket route yet, so STOMP connects to game-service directly.
    location /ws/ {
        proxy_pass ${GAME_SERVICE_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }

    # SPA fallback: React Router handles every other path.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
